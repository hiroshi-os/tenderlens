[Unit]
Description=TenderLens Celery worker
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/tenderlens
EnvironmentFile=/etc/tenderlens.env
ExecStart=/opt/tenderlens/.venv/bin/celery -A config worker --loglevel=info
Restart=on-failure

[Install]
WantedBy=multi-user.target
