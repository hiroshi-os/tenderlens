[Unit]
Description=TenderLens Celery beat
After=network.target postgresql.service redis-server.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/tenderlens
EnvironmentFile=/etc/tenderlens.env
ExecStart=/opt/tenderlens/.venv/bin/celery -A config beat --loglevel=info --schedule=/var/lib/tenderlens/celerybeat-schedule
Restart=on-failure

[Install]
WantedBy=multi-user.target
